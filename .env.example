APP_NAME="PRMSU Iba Campus QR Hardcopy DTRMS"
APP_ENV=local
BASE_URL=/prmsu-dtrms-qr_v2
# Optional full public URL used in printed QR links, for example https://your-host/prmsu-dtrms-qr_v2
APP_PUBLIC_URL=
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE_OFFSET=+08:00
SECURITY_HEADERS_ENABLED=true
MIGRATIONS_AUTO_RUN=true
BACKUP_DIR=C:/xampp/backups/prmsu-dtrms-qr_v2
# Optional MySQL backup client settings. Use MySQL 8 mysqldump for MySQL 8 servers.
BACKUP_MYSQLDUMP_PATH=
BACKUP_MYSQL_PATH=
BACKUP_MYSQL_PLUGIN_DIR=
# Required for emergency restore actions. Set this to a long random secret before using restore.
BACKUP_RESTORE_TOKEN=
# Required for encrypted backups. Set this to a long random secret and keep it outside backup archives.
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prmsu_dtrms
DB_USER=root
DB_PASS=

APP_KEY=change-me-to-a-random-secret-key
# Enables email OTP for account recovery only. Login uses User ID and password.
AUTH_OTP_ENABLED=true

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="PRMSU Iba Campus QR Hardcopy DTRMS"

OTP_CODE_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=600
OTP_MAX_ATTEMPTS=5
MAX_UPLOAD_BYTES=15728640
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCK_SECONDS=300
PASSWORD_MIN_LENGTH=12
